% Drafted CANONICAL rules. One group per header layout; run each layout's sample list with its group.

% L01 (153 recordings): EOG_horizontal -> EOG. Single horizontal EOG channel with no side given, and the trace looks neuro, so it maps to generic EOG. Evidence: 1 flag, 152 high
EOG
 group:
  L01
 req:
  sig = EOG_horizontal
  unit = uV
  unit = mV
  unit = V
 set:
  unit = uV

% L01 (153 recordings): Resp_oro_nasal -> airflow. Oro-nasal thermistor airflow, but it is sampled at 1 Hz and the trace looks like hr or slow, so airflow is kept with caution. Evidence: 153 medium
airflow
 group:
  L01
 req:
  sig = Resp_oro_nasal

% L01 (153 recordings): EMG_submental -> EMG. Submental EMG, rectified and low-passed at 1 Hz, is still the chin EMG envelope. Evidence: 153 medium
EMG
 group:
  L01
 req:
  sig = EMG_submental
  unit = uV
  unit = mV
  unit = V
 set:
  unit = uV

% L02 (44 recordings): EOG_horizontal -> EOG. Single horizontal EOG channel with no side in label; trace is neuro-like in most recordings. Evidence: 2 flag, 42 high
EOG
 group:
  L02
 req:
  sig = EOG_horizontal
  unit = uV
  unit = mV
  unit = V
 set:
  unit = uV

% L02 (44 recordings): EMG_submental -> EMG. Submental (chin) EMG, trace shows EMG in most recordings. Evidence: 12 flag, 32 high
EMG
 group:
  L02
 req:
  sig = EMG_submental
  unit = uV
  unit = mV
  unit = V
 set:
  unit = uV

