% Drafted CANONICAL rules. One group per header layout; run each layout's sample list with its group.

% L01 (153 recordings): EOG_horizontal -> EOG. Single horizontal EOG derivation with no side specified maps to generic EOG. Evidence: 1 flag, 152 high
EOG
 group:
  L01
 req:
  sig = EOG_horizontal
  unit = uV
  unit = mV
  unit = V
 set:
  unit = uV

% L01 (153 recordings): Resp_oro_nasal -> airflow. Oral-nasal thermistor airflow signal maps to airflow. Evidence: 153 medium
airflow
 group:
  L01
 req:
  sig = Resp_oro_nasal

% L01 (153 recordings): EMG_submental -> EMG. Submental (chin) EMG maps to EMG, though it is a rectified 1 Hz envelope. Evidence: 153 medium
EMG
 group:
  L01
 req:
  sig = EMG_submental
  unit = uV
  unit = mV
  unit = V
 set:
  unit = uV

